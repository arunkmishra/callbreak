# Use JDK for both build and runtime to simplify things
FROM eclipse-temurin:21-jdk

WORKDIR /app

# Copy gradle wrapper and files
COPY gradlew .
COPY gradle gradle
COPY build.gradle.kts .
COPY settings.gradle.kts .
COPY gradle.properties* ./

# Give execute permission to gradlew
RUN chmod +x gradlew

# Download dependencies
RUN ./gradlew dependencies || true

# Copy source code
COPY src src

# Build the application using installDist
RUN ./gradlew installDist

# We expose 8080 (Render overrides with PORT environment variable)
EXPOSE 8080

# Run the script generated by Gradle
CMD ["./build/install/callbreak-backend/bin/callbreak-backend"]
